{
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/vendor/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/vendor": true
    },
    // Disable expensive JS/TS suggestion features
    "js/ts.suggest.includeAutomaticOptionalChainCompletions": false,
    "js/ts.suggest.objectLiteralMethodSnippets.enabled": false,
    "typescript.suggest.autoImports": false,
    "typescript.disableAutomaticTypeAcquisition": true,
    "editor.minimap.showSlider": "always",
    "terminal.integrated.scrollback": 10000,
    "git.openRepositoryInParentFolders": "never",
    "files.autoSave": "afterDelay",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "javascript.updateImportsOnPaste.enabled": false,

    "html.format.contentUnformatted": "",
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "auto-close-tag.activationOnLanguage": [
        "xml",
        "php",
        "blade",
        "ejs",
        "jinja",
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "plaintext",
        "markdown",
        "vue",
        "liquid",
        "erb",
        "lang-cfml",
        "cfml",
        "HTML (EEx)",
        "HTML (Eex)",
        "plist"
    ],
    "editor.formatOnSave": true,
    "git.autofetch": true,
    "colorize.languages": ["typescript", "javascript", "css", "scss", "vue"],
    "colorize.exclude": [
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/CVS",
        "**/.DS_Store",
        "**/node_modules",
        "**/bower_components",
        "**/tmp",
        "**/dist",
        "**/tests"
    ],
    "editor.tabCompletion": "on",
    "security.workspace.trust.untrustedFiles": "open",
    "[javascript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "indentRainbow.includedLanguages": [
        "javascript",
        "vue",
    ],
    "indentRainbow.indicatorStyle": "light",
    "security.promptForLocalFileProtocolHandling": false,
    "terminal.integrated.tabs.enabled": false,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "editor.wordWrap": "on",
    "typescript.tsc.autoDetect": "off",
    "typescript.updateImportsOnPaste.enabled": false,
    "extensions.ignoreRecommendations": true,
    "[json]": {
        "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
    },
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false,
        "vue": true,
        "javascript": true
    },
    "csv.enabled": true,

    "chat.viewSessions.orientation": "stacked",
    "chat.agent.maxRequests": 26000000000000000000,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "window.newWindowProfile": "Default",
    "workbench.colorTheme": "Mermaid Dark",
    "update.showReleaseNotes": false,
    "workbench.startupEditor": "none",
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "/usr/bin/bash"
        },
    },
    "terminal.integrated.defaultProfile.linux": "bash",
}